{
  "name": "gw2-raid-tool",
  "productName": "GW2 Raid Tool",
  "version": "5.4.2",
  "description": "Das ultimative Programm fürs Raiden",
  "main": "./out/main/index.js",
  "author": "MuwuM",
  "license": "MIT",
  "homepage": "https://github.com/MuwuM/gw2-raid-tool",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "npm run build && electron-builder --mac --config",
    "build:linux": "npm run build && electron-builder --linux --config",
    "pack": "npm run build && node ./out/main/pack.js",
    "fetch-specs": "npm run build && node ./out/main/fetch-specs.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@fynnix/node-easy-ipc": "^1.1.4",
    "@octokit/rest": "^22.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "ahk.exe": "^1.2.1",
    "ahknodejs": "^2.0.0",
    "bootswatch": "^5.3.8",
    "chokidar": "^5.0.0",
    "electron-vite": "^6.0.0-beta.1",
    "fast-xml-parser": "^5.11.0",
    "file-type": "^22.0.2",
    "fuse.js": "^7.5.0",
    "gw2api-client": "^7.8.7",
    "ini": "^7.0.0",
    "jszip": "^3.10.1",
    "less": "^4.9.0",
    "luxon": "^3.7.2",
    "nedb-promises": "^6.2.4",
    "node-processlist": "^1.0.2",
    "node-windows": "^1.0.0-beta.8",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.5.0",
    "typescript": "^6.0.3",
    "urllib": "^4.9.0",
    "vite": "^8.2.2",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.0",
    "@types/ini": "^4.1.1",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.2.0",
    "@types/node-windows": "^0.1.6",
    "@types/semver": "^7.8.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/stream-chain": "^2.1.0",
    "@types/stream-json": "^1.7.8",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-winstaller": "^5.4.4",
    "eslint-plugin-vue": "^10.10.0",
    "install": "^0.13.0",
    "minimatch": "^10.2.6",
    "muwum-eslint-config": "github:MuwuM/muwum-eslint-config",
    "node-abi": "^4.33.0",
    "npm": "^12.0.2",
    "prettier": "^3.9.6",
    "ssh2-sftp-client": "^12.1.1",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "node-abi": "^4.33.0"
  }
}
